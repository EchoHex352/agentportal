{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/healthz",
      "dest": "server/index.js"
    },
    {
      "src": "/public/(.*)",
      "dest": "public/$1"
    },
    {
      "src": "/",
      "dest": "server/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "BIND_HOST": "0.0.0.0"
  }
}
