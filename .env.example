# Agent Oversight Portal - Environment Variables
# Copy to .env and fill with real values (never commit .env)

# Server
PORT=3000
NODE_ENV=production
BIND_HOST=0.0.0.0

# Authentication
PORTAL_INGEST_TOKEN=your-secret-ingest-token-here

# Database
DB_PATH=/app/data/events.db

# Telegram Alert Routing
TELEGRAM_GROUP_ID=-1003922846165
ALERT_MIN_SEVERITY=warning
ALERT_RATE_LIMIT=1
ALERT_RATE_WINDOW_SECS=3600
ALERT_BUSINESS_HOURS_START=9
ALERT_BUSINESS_HOURS_END=17
ALERT_BUSINESS_HOURS_TZ=America/New_York

# OpenClaw Integration (for alerts)
# Option A: Use OpenClaw CLI (recommended)
USE_OPENCLAW_CLI=true
# Option B: Use Telegram Bot API directly
# TELEGRAM_BOT_TOKEN=your-bot-token-here
